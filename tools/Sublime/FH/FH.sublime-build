{
	// Runs the current script with the `fh` interpreter.
	// If `fh` is not on your PATH, replace it with an absolute path
	// (e.g. "/usr/local/bin/fh" or "C:\\fh\\fh.exe").
	"shell_cmd": "fh \"$file\"",
	"selector": "source.fh",
	"working_dir": "$file_path",

	// Matches both compile-time and run-time diagnostics:
	//   ERROR: error: file.fh:2:11: unexpected ';'
	//   ERROR: file.fh:2:9: error: boom
	"file_regex": "([^\\s:]+\\.fh):([0-9]+):([0-9]+):\\s*(?:error:\\s*)?(.*)$",

	"variants": [
		{
			// Same as above, but from the project root instead of the file's
			// directory -- handy when `include` paths are relative to it.
			"name": "Run from Project Root",
			"working_dir": "$folder"
		},
		{
			// `fh -d` dumps the generated bytecode before executing.
			"name": "Dump Bytecode",
			"shell_cmd": "fh -d \"$file\""
		},
		{
			// `fh -o` dumps every docstring found in the program.
			"name": "Dump Documentation",
			"shell_cmd": "fh -o \"$file\""
		},
		{
			// `fh -p PATH MAIN_FILE.fh` runs a .fhpack project; this treats the
			// current file as the entry point of the package next to it.
			"name": "Run .fhpack Project",
			"shell_cmd": "fh -p \"${file_path}/${file_base_name}.fhpack\" \"${file_name}\""
		}
	]
}
